<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" stylesheets="@../../../styles/juego.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.proyecto1_app.JuegoController">
   <top>
      <VBox alignment="CENTER" prefHeight="115.0" prefWidth="600.0" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblPregunta" alignment="BOTTOM_RIGHT" contentDisplay="CENTER" text="PREGUNTA">
               <padding>
                  <Insets top="15.0" />
               </padding>
            </Label>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
               <children>
                  <ProgressBar fx:id="progressBar" prefWidth="200.0" progress="0.0" />
                  <Label fx:id="lblPuntuacion" text="PUNTUACIÓN" />
               </children>
               <padding>
                  <Insets left="15.0" top="15.0" />
               </padding>
            </HBox>
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </VBox>
   </top>
   <center>
      <VBox prefHeight="143.0" prefWidth="600.0" stylesheets="@../../../styles/style.css" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblEnunciado" text="ENUNCIADO">
               <padding>
                  <Insets bottom="15.0" />
               </padding></Label>
            <RadioButton fx:id="op1" mnemonicParsing="false" text="Opcion a" />
            <RadioButton fx:id="op2" mnemonicParsing="false" text="Opcion b" />
            <RadioButton fx:id="op3" mnemonicParsing="false" text="Opcion c" />
            <RadioButton fx:id="op4" mnemonicParsing="false" text="Opcion d" />
         </children>
         <padding>
            <Insets left="20.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
          <Button fx:id="btnSalir" alignment="CENTER" mnemonicParsing="false" onAction="#clickSalir" text="SALIR" />
          <Button fx:id="btnComprobar" alignment="CENTER" mnemonicParsing="false" onAction="#clickComprobar" text="COMPROBAR" />
          <Button fx:id="btnSiguiente" mnemonicParsing="false" onAction="#clickSiguiente" text="SIGUIENTE" />
         </children>
         <padding>
            <Insets bottom="15.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
