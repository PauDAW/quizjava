<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" stylesheets="@../../../styles/ranking.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.proyecto1_app.RankingController">
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblRanking" text="RANKING" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="tablaRanking" prefHeight="207.0" prefWidth="600.0">
              <columns>
                  <TableColumn fx:id="colTop" prefWidth="75.0" text="TOP" />
                <TableColumn fx:id="colUsuario" prefWidth="75.0" text="USUARIO" />
                <TableColumn fx:id="colAciertos" prefWidth="75.0" text="ACIERTOS" />
                  <TableColumn fx:id="colFallos" prefWidth="75.0" text="FALLOS" />
                  <TableColumn fx:id="colNota" prefWidth="75.0" text="NOTA FINAL" />
              </columns>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </VBox.margin>
               <columnResizePolicy>
    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
</columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#accionSalir" text="SALIR" />
            <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#accionVolver" text="VOLVER AL MENÚ" />
            <Button fx:id="btnBorrar" mnemonicParsing="false" onAction="#accionBorrarRanking" text="BORRAR" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
